// Prisma schema — Vocabolario del Crucipuzzle
// Architettura: Lingue -> Categorie -> Parole
// (concetto funzionale standard per word search, implementazione originale)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Language {
  id         Int         @id @default(autoincrement())
  code       String      @unique // "it", "en"
  name       String // "Italiano"
  emoji      String // "🇮🇹"
  categories Category[]
}

model Category {
  id          Int      @id @default(autoincrement())
  languageId  Int
  language    Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String
  emoji       String
  color       String // classi Tailwind per la tile
  words       Word[]

  @@unique([languageId, slug])
}

model Word {
  id         Int      @id @default(autoincrement())
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  text       String // "GATTO" — maiuscolo, senza spazi/accenti
  difficulty String   @default("medium") // easy | medium | hard (per lunghezza)

  @@index([categoryId])
}
